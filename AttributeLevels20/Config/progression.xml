    <!-- The vanilla skill window already pages attribute rows after ten entries. -->
    <set xpath="/progression/attributes/@max_level">20</set>

    <!-- Extend the five main attributes. Each effect continues the vanilla curve at a constant per-level increment. -->
    <set xpath="/progression/attributes/attribute[@name='attPerception']/@max_level">20</set>
    <set xpath="/progression/attributes/attribute[@name='attStrength']/@max_level">20</set>
    <set xpath="/progression/attributes/attribute[@name='attFortitude']/@max_level">20</set>
    <set xpath="/progression/attributes/attribute[@name='attAgility']/@max_level">20</set>
    <set xpath="/progression/attributes/attribute[@name='attIntellect']/@max_level">20</set>

    <!-- The attribute row controller requires an effect_description entry to render each level. -->
    <append xpath="/progression/attributes/attribute[@name='attStrength']/effect_group[last()]"><effect_description level="11" desc_key="attStrengthRank10Desc"/><effect_description level="12" desc_key="attStrengthRank10Desc"/><effect_description level="13" desc_key="attStrengthRank10Desc"/><effect_description level="14" desc_key="attStrengthRank10Desc"/><effect_description level="15" desc_key="attStrengthRank10Desc"/><effect_description level="16" desc_key="attStrengthRank10Desc"/><effect_description level="17" desc_key="attStrengthRank10Desc"/><effect_description level="18" desc_key="attStrengthRank10Desc"/><effect_description level="19" desc_key="attStrengthRank10Desc"/><effect_description level="20" desc_key="attStrengthRank10Desc"/></append>
