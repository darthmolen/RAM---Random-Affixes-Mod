<configs>
    <!-- Strengthen existing food-specific buffs while retaining their vanilla identities. -->
    <set xpath="/buffs/buff[@name='buffShamChowder']/effect_group/passive_effect[@name='AttributeLevel']/@value">2</set>
    <append xpath="/buffs/buff[@name='buffShamChowder']/effect_group[last()]"><passive_effect name="HealthMax" operation="base_add" value="20"/></append>
    <!-- Match the vanilla maximum-stamina-bonus pattern: initialize once, add once per buff stack, and cap the total duration. -->
    <append xpath="/buffs/buff[@name='buffShamChowder']/effect_group[1]"><triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$buffShamChowderDuration" operation="set" value="1203"/><triggered_effect trigger="onSelfBuffStack" action="ModifyCVar" cvar="$buffShamChowderDuration" operation="add" value="1203"/><triggered_effect trigger="onSelfBuffStack" action="ModifyCVar" cvar="$buffShamChowderDuration" operation="set" value="3603"><requirement name="CVarCompare" cvar="$buffShamChowderDuration" operation="GT" value="3603"/></triggered_effect></append>
    <set xpath="/buffs/buff[@name='buffChickenWings']/effect_group/passive_effect[@name='EntityDamage']/@value">.2</set>
    <set xpath="/buffs/buff[@name='buffChickenWings']/effect_group/passive_effect[@name='BuffResistance']/@value">4</set>
    <append xpath="/buffs/buff[@name='buffChickenWings']/effect_group[last()]"><passive_effect name="AttacksPerMinute" operation="perc_add" value=".15" tags="melee"/></append>
    <append xpath="/buffs/buff[@name='buffRoadrunner']/effect_group[last()]"><passive_effect name="StaminaChangeOT" operation="perc_add" value=".2" tags="running"/></append>

    <!-- The shared vanilla maximum-stamina buff stacks duration instead of resetting it. Food-specific CVars override the seven-minute fallback. -->
    <set xpath="/buffs/buff[@name='buffFoodStaminaBonus']/effect_group[1]/triggered_effect[@trigger='onSelfBuffStack' and @cvar='$buffFoodStaminaBonusDuration']/@operation">add</set>
    <append xpath="/buffs/buff[@name='buffFoodStaminaBonus']/effect_group[1]/triggered_effect[@trigger='onSelfBuffStack' and @cvar='$buffFoodStaminaBonusDuration']"><requirement name="CVarCompare" cvar=".fpbFoodStaminaDurationAdd" operation="LTE" value="0"/></append>
