<configs>
    <append xpath="/xui">
        <window_group name="workstation_ramAffixBench" controller="WeaponAffixesProject.XUiC_RamBenchWindowGroup,WeaponAffixesProject" open_backpack_on_open="true" close_compass_on_open="true" defaultselected="affixGrid">
            <window name="windowCraftingList" visible="false"/>
            <window name="craftingInfoPanel" visible="false"/>
            <window name="windowCraftingQueue" visible="false"/>
            <window name="windowRamAffixBrowser"/>
        </window_group>
    </append>

    <insertAfter xpath="/xui/window_group[@name='combine']/window[@name='windowCombine']">
        <window name="windowCombineAffixChooser" />
    </insertAfter>
</configs>
